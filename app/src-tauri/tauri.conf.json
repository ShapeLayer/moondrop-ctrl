{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moondrop Ctrl",
  "version": "0.3.0",
  "identifier": "local.moondrop.ctrl",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Moondrop Ctrl",
        "width": 1120,
        "height": 800,
        "minWidth": 900,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Korean",
          "English",
          "Japanese"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": [
          "ko-KR",
          "en-US",
          "ja-JP"
        ]
      }
    }
  }
}
